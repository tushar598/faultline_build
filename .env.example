# Copy to .env only for NON-SECRET values. .env is git-ignored.
#
# Private keys never go in any file in this repo. Set them in the current terminal only:
#   read -s HEDERA_TESTNET_PK && export HEDERA_TESTNET_PK
# (Hardhat 2 has no encrypted keystore; `npx hardhat vars set` stores values in plain text,
#  so we do not use it for keys. See docs/LESSONS.md.)

# Hedera testnet JSON-RPC relay (chain id 296)
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api

# Hedera testnet mirror node REST API
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# ATS v8 testnet deployment (see docs/reference/ats.md)
ATS_FACTORY_ID=0.0.9213391
ATS_RESOLVER_ID=0.0.9212226

# Filled in after a deployment (EVM addresses, 0x-prefixed); this repo's current ids: docs/DEPLOYMENTS.md
BOND_ADDRESS=
STABLECOIN_ADDRESS=
POOL_ADDRESS=
TRIGGER_ADDRESS=
HCS_TOPIC_ID=

# Oracle
USGS_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1
