{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "description": "Parametric earthquake catastrophe bond on Hedera (ATS bond + HTS stablecoin + USGS oracle)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix oracle ci && npm --prefix web ci && npm --prefix ops ci",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "e2e:local": "hardhat run scripts/e2e-local.ts",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "oracle:e2e:local": "node scripts/with-local-node.mjs npx hardhat run scripts/oracle-e2e-local.ts --network localhost",
    "typecheck": "tsc --noEmit",
    "oracle:typecheck": "npm --prefix oracle run typecheck",
    "oracle:test": "npm --prefix oracle test",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "check": "npm run compile && npm test && npm run typecheck && npm run oracle:typecheck && npm run ops:typecheck && npm run oracle:test && npm run web:lint && npm run web:test && npm run web:build",
    "web:test": "npm --prefix web test",
    "web:e2e": "node scripts/with-local-node.mjs npm --prefix web run e2e",
    "dashboard:demo:local": "hardhat run scripts/dashboard-demo-local.ts --network localhost",
    "ops:setup": "npm --prefix ops ci",
    "ops:typecheck": "npm --prefix ops run typecheck",
    "ops:demo:0": "npm --prefix ops run demo:0",
    "ops:demo:1": "npm --prefix ops run demo:1",
    "ops:demo:2": "npm --prefix ops run demo:2",
    "ops:demo:3": "npm --prefix ops run demo:3",
    "ops:demo:4": "npm --prefix ops run demo:4",
    "ops:demo:5": "npm --prefix ops run demo:5",
    "ops:demo:6": "npm --prefix ops run demo:6",
    "ops:demo:7": "npm --prefix ops run demo:7",
    "ops:demo:rt02": "npm --prefix ops run demo:rt02",
    "ops:issuer:topic": "npm --prefix ops run issuer:topic",
    "ops:issuer:kyc": "npm --prefix ops run issuer:kyc"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "fast-check": "4.10.2",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "1.0.10",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
